# Lightweight container for the mock MCP tool server used by docker-compose.
FROM python:3.11-slim

WORKDIR /app
RUN pip install --no-cache-dir fastapi==0.115.0 uvicorn[standard]==0.30.6

COPY docker/mcp_stub_server.py ./mcp_stub_server.py

EXPOSE 8801
CMD ["uvicorn", "mcp_stub_server:app", "--host", "0.0.0.0", "--port", "8801"]
